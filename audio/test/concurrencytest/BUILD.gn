import("//build/test.gni")
import("./../../audio.gni")

module_output_path = "drivers_peripheral_audio/drivers_peripheral_audio"

ohos_unittest("hdf_audio_concurrency_test") {
  module_out_path = module_output_path

  sources = [
    "adapter/audio_adapter_concurrency_test.cpp",
    "capture/audio_capture_concurrency_test.cpp",
    "manager/audio_manager_concurrency_test.cpp",
    "render/audio_render_concurrency_test.cpp",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "drivers_interface_audio:libaudio_proxy_6.1",
    "hdf_core:libhdf_utils",
  ]
  if (defined(ohos_lite)) {
    external_deps += [ "hilog_lite:hilog_share" ]
  } else {
    external_deps += [ "hilog:libhilog" ]
  }
  if (enable_c_utils) {
    external_deps += [ "c_utils:utils" ]
  }

  defines = []
  if (drivers_peripheral_audio_feature_community) {
    defines += [ "AUDIO_FEATURE_COMMUNITY" ]
  }
}
