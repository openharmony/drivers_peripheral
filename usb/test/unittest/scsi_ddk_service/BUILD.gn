import("//build/config/sanitizers/sanitizers.gni")
import("//build/test.gni")

module_output_path = "drivers_peripheral_usb/drivers_peripheral_usb"

ohos_unittest("scsi_ddk_service_test") {
  module_out_path = module_output_path

  include_dirs = [
    "./../../../ddk_service/scsi_service/include",
    "./../../../ddk_service/common/include",
    "./../../../utils/include",
  ]

  sources = [ "scsi_ddk_service_test.cpp" ]

  deps = [ "./../../../ddk_service/scsi_service:libscsi_peripheral_ddk_service_1.0" ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "drivers_interface_usb:libscsi_ddk_proxy_1.0",
    "googletest:gtest_main",
    "hdf_core:libhdf_utils",
    "hdf_core:libhdi",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]
}
